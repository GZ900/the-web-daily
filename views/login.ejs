<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <title><%= pageTitle %> | The Web Daily</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/site.css">
</head>
<body data-login-page>
    <%- include("partials/staffHeader") %>
    <main class="login-shell">
        <section class="login-card" aria-labelledby="login-title">
            <span class="section-eyebrow">YOUR NEWSROOM</span>
            <h1 id="login-title">Welcome back.</h1>
            <p>Log in to your Reporter or Editor workspace.</p>
            <% if (errorMessage) { %>
                <p class="login-error" role="alert"><%= errorMessage %></p>
            <% } %>
            <form class="login-form" method="POST" action="/login">
                <%- include("partials/loginFields", { fieldPrefix: "page" }) %>
            </form>
            <a class="login-fallback-link" href="/">Back to the latest stories</a>
        </section>
    </main>
    <%- include("partials/siteFooter") %>
</body>
</html>
