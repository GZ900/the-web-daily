<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="color-scheme"
        content="light dark"
    >

    <title><%= pageTitle %></title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="stylesheet"
        href="/css/dashboard.css"
    >

    <link
        rel="stylesheet"
        href="/css/analytics.css"
    >

    <script
        src="https://cdn.jsdelivr.net/npm/chart.js"
        defer
    ></script>

    <script
        src="/js/analytics.js"
        defer
    ></script>
    <link rel="stylesheet" href="/css/site.css">
</head>

<body class="staff-page">

    <%- include("../partials/staffHeader", {
        staffRole: "editor",
        activeSection: "analytics"
    }) %>

    <main class="dashboard-shell">

        <header class="dashboard-page-heading">

            <div>

                <span class="dashboard-eyebrow">
                    NEWSROOM INSIGHTS
                </span>

                <h1>
                    Analytics Impact.
                </h1>

                <p>
                    Explore readership over time
                    and see how publication updates
                    affect article performance.
                </p>

            </div>

        </header>

        <% if (articles.length === 0) { %>

            <section class="dashboard-empty-state">

                <h2>
                    No published articles
                </h2>

                <p>
                    Analytics will become available
                    after an article is published.
                </p>

            </section>

        <% } else { %>

            <section class="analytics-toolbar">

                <div class="analytics-toolbar-grid">

                    <label class="analytics-compact-field">

                        <span class="analytics-field-label">
                            Search
                        </span>

                        <input
                            type="search"
                            id="analytics-article-search"
                            placeholder="Search title..."
                            autocomplete="off"
                        >

                    </label>

                    <div class="analytics-compact-field">

                        <span class="analytics-field-label">
                            Reporter
                        </span>

                        <div
                            class="analytics-custom-select"
                            id="reporter-custom-select"
                        >

                            <button
                                type="button"
                                class="analytics-select-button"
                                id="analytics-reporter-button"
                                aria-haspopup="listbox"
                                aria-expanded="false"
                            >

                                <span
                                    class="analytics-select-value"
                                    id="analytics-reporter-value"
                                >
                                    All Reporters
                                </span>

                                <span
                                    class="analytics-select-chevron"
                                    aria-hidden="true"
                                >
                                    ⌄
                                </span>

                            </button>

                            <div
                                class="analytics-select-menu"
                                id="analytics-reporter-menu"
                                role="listbox"
                                hidden
                            ></div>

                        </div>

                        <select
                            id="analytics-reporter"
                            class="analytics-data-select"
                            tabindex="-1"
                            aria-hidden="true"
                        >

                            <option value="">
                                All Reporters
                            </option>

                        </select>

                    </div>

                    <div class="analytics-compact-field analytics-article-field">

                        <span class="analytics-field-label">
                            Article
                        </span>

                        <div
                            class="analytics-custom-select"
                            id="article-custom-select"
                        >

                            <button
                                type="button"
                                class="analytics-select-button"
                                id="analytics-article-button"
                                aria-haspopup="listbox"
                                aria-expanded="false"
                            >

                                <span
                                    class="analytics-select-value"
                                    id="analytics-article-value"
                                >
                                    Choose an article
                                </span>

                                <span
                                    class="analytics-select-chevron"
                                    aria-hidden="true"
                                >
                                    ⌄
                                </span>

                            </button>

                            <div
                                class="analytics-select-menu analytics-article-menu"
                                id="analytics-article-menu"
                                role="listbox"
                                hidden
                            ></div>

                        </div>

                        <select
                            id="analytics-article"
                            class="analytics-data-select"
                            tabindex="-1"
                            aria-hidden="true"
                        >

                            <% articles.forEach(article => { %>

                                <option
                                    value="<%= article._id %>"
                                    data-title="<%= article.publishedVersion.title %>"
                                    data-reporter-id="<%= article.author ? article.author._id : "" %>"
                                    data-reporter-name="<%= article.author ? article.author.displayName : "Unknown" %>"
                                >
                                    <%= article.publishedVersion.title %>
                                    —
                                    <%= article.author
                                        ? article.author.displayName
                                        : "Unknown" %>
                                </option>

                            <% }) %>

                        </select>

                    </div>

                    <label class="analytics-compact-field">

                        <span class="analytics-field-label">
                            Time Range
                        </span>

                        <select
                            id="analytics-range"
                            class="analytics-native-select"
                        >

                            <option value="30m">
                                Last 30 minutes
                            </option>

                            <option value="1h">
                                Last hour
                            </option>

                            <option value="3h">
                                Last 3 hours
                            </option>

                            <option value="6h">
                                Last 6 hours
                            </option>

                            <option value="12h">
                                Last 12 hours
                            </option>

                            <option value="24h">
                                Last 24 hours
                            </option>

                            <option
                                value="7d"
                                selected
                            >
                                Last 7 days
                            </option>

                            <option value="30d">
                                Last 30 days
                            </option>

                            <option value="90d">
                                Last 90 days
                            </option>

                            <option value="custom">
                                Custom range
                            </option>

                        </select>

                    </label>

                </div>

                <p
                    id="analytics-search-message"
                    class="analytics-filter-message"
                    aria-live="polite"
                ></p>

            </section>

            <section
                id="custom-range-controls"
                class="custom-range-card"
                hidden
            >

                <div>

                    <span class="dashboard-eyebrow">
                        CUSTOM RANGE
                    </span>

                    <h2>
                        Choose a time window
                    </h2>

                    <p>
                        Custom ranges can cover
                        up to 90 days.
                    </p>

                </div>

                <div class="custom-range-fields">

                    <label class="dashboard-control">

                        <span>
                            From
                        </span>

                        <input
                            type="datetime-local"
                            id="analytics-start"
                        >

                    </label>

                    <label class="dashboard-control">

                        <span>
                            To
                        </span>

                        <input
                            type="datetime-local"
                            id="analytics-end"
                        >

                    </label>

                    <button
                        class="secondary-action"
                        type="button"
                        id="apply-custom-range"
                    >
                        Apply Range
                    </button>

                </div>

            </section>

            <section class="analytics-overview">

                <div class="analytics-heading-card">

                    <div>

                        <span class="analytics-card-label">
                            Selected Article
                        </span>

                        <h2 id="analytics-title">
                            Loading analytics...
                        </h2>

                    </div>

                    <div class="analytics-total-card">

                        <span>
                            Total Views
                        </span>

                        <strong id="analytics-total-views">
                            -
                        </strong>

                        <small>
                            All time
                        </small>

                    </div>

                </div>

                <p
                    id="analytics-message"
                    class="analytics-message"
                    aria-live="polite"
                ></p>

                <section class="analytics-chart-card">

                    <header class="analytics-section-header">

                        <div>

                            <span class="analytics-card-label">
                                VIEW ACTIVITY
                            </span>

                            <h3>
                                Views over time
                            </h3>

                        </div>

                        <span class="analytics-time-note">
                            Local time · 24-hour format
                        </span>

                    </header>

                    <div class="analytics-chart-wrapper">

                        <canvas
                            id="analytics-chart"
                        ></canvas>

                    </div>

                </section>

                <section class="publication-card">

                    <header class="analytics-section-header">

                        <div>

                            <span class="analytics-card-label">
                                PUBLICATION HISTORY
                            </span>

                            <h3>
                                Publication Events
                            </h3>

                        </div>

                    </header>

                    <div
                        id="publication-events"
                        class="publication-events"
                    ></div>

                </section>

            </section>

        <% } %>

    </main>

</body>

</html>