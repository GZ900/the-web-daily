<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="color-scheme"
        content="light dark"
    >

    <title><%= pageTitle %></title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="stylesheet"
        href="/css/dashboard.css"
    >

    <script
        src="/js/adminComments.js"
        defer
    ></script>
</head>

<body class="staff-page">

    <%- include("../partials/staffHeader", {
        staffRole: "editor",
        activeSection: "comments"
    }) %>

    <main class="dashboard-shell">

        <header class="dashboard-page-heading">

            <div>

                <span class="dashboard-eyebrow">
                    MODERATION
                </span>

                <h1>
                    Comment Management.
                </h1>

                <p>
                    Review, edit and remove
                    reader comments across
                    published stories.
                </p>

            </div>

        </header>

        <section class="dashboard-controls-panel">

            <form
                class="dashboard-controls comment-filter-controls"
                method="GET"
                action="/editor/comments"
            >

                <label class="dashboard-control dashboard-search-control">

                    <span>
                        Search
                    </span>

                    <input
                        type="search"
                        name="search"
                        value="<%= search %>"
                        placeholder="Name or comment text"
                    >

                </label>

                <label class="dashboard-control">

                    <span>
                        Sort
                    </span>

                    <select name="sort">

                        <option
                            value="newest"
                            <%= selectedSort === "newest" ? "selected" : "" %>
                        >
                            Newest
                        </option>

                        <option
                            value="oldest"
                            <%= selectedSort === "oldest" ? "selected" : "" %>
                        >
                            Oldest
                        </option>

                    </select>

                </label>

                <div class="dashboard-filter-actions">

                    <button
                        class="secondary-action"
                        type="submit"
                    >
                        Apply
                    </button>

                    <a
                        class="text-action"
                        href="/editor/comments"
                    >
                        Clear
                    </a>

                </div>

            </form>

        </section>

        <div class="dashboard-result-heading">

            <p class="dashboard-summary">

                <strong>
                    <%= totalComments %>
                </strong>

                comment<%= totalComments === 1 ? "" : "s" %>

            </p>

        </div>

        <section
            id="comment-list"
            class="management-list"
        >

            <% comments.forEach(comment => { %>

                <%
                    const articleTitle =
                        comment.article
                            ? (
                                comment.article.publishedVersion &&
                                comment.article.publishedVersion.title
                                    ? comment.article.publishedVersion.title
                                    : comment.article.workingVersion.title
                            )
                            : "Deleted article";
                %>

                <article
                    class="management-card comment-card"
                    data-comment-id="<%= comment._id %>"
                >

                    <div class="comment-card-header">

                        <div>

                            <span class="management-card-label">
                                ARTICLE
                            </span>

                            <h2>
                                <%= articleTitle %>
                            </h2>

                        </div>

                        <time
                            datetime="<%= new Date(comment.createdAt).toISOString() %>"
                        >
                            <%= new Date(
                                comment.createdAt
                            ).toLocaleString(
                                "en-GB",
                                {
                                    day: "2-digit",
                                    month: "short",
                                    year: "numeric",
                                    hour: "2-digit",
                                    minute: "2-digit",
                                    hour12: false
                                }
                            ) %>
                        </time>

                    </div>

                    <div class="comment-editor-grid">

                        <label class="dashboard-control">

                            <span>
                                Reader Name
                            </span>

                            <input
                                class="comment-name"
                                value="<%= comment.name %>"
                            >

                        </label>

                        <label class="dashboard-control">

                            <span>
                                Comment
                            </span>

                            <textarea
                                class="comment-text"
                                rows="4"
                            ><%= comment.text %></textarea>

                        </label>

                    </div>

                    <div class="management-card-footer">

                        <p
                            class="comment-message management-message"
                            aria-live="polite"
                        ></p>

                        <div class="management-actions">

                            <button
                                type="button"
                                class="save-comment secondary-action"
                            >
                                Save Changes
                            </button>

                            <button
                                type="button"
                                class="delete-comment danger-action"
                            >
                                Delete
                            </button>

                        </div>

                    </div>

                </article>

            <% }) %>

        </section>

        <% if (totalPages > 1) { %>

            <nav
                class="dashboard-pagination"
                aria-label="Comment pages"
            >

                <% if (page > 1) { %>

                    <a
                        href="/editor/comments?<%= paginationQuery ? paginationQuery + '&' : '' %>page=<%= page - 1 %>"
                    >
                        Previous
                    </a>

                <% } %>

                <span class="pagination-summary">
                    Page
                    <%= page %>
                    of
                    <%= totalPages %>
                </span>

                <% if (page < totalPages) { %>

                    <a
                        href="/editor/comments?<%= paginationQuery ? paginationQuery + '&' : '' %>page=<%= page + 1 %>"
                    >
                        Next
                    </a>

                <% } %>

            </nav>

        <% } %>

    </main>

</body>

</html>