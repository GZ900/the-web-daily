<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="color-scheme"
        content="light dark"
    >

    <title><%= pageTitle %></title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="stylesheet"
        href="/css/dashboard.css"
    >

    <script
        src="/js/adminUsers.js"
        defer
    ></script>
</head>

<body class="staff-page">

    <%- include("../partials/staffHeader", {
        staffRole: "editor",
        activeSection: "users"
    }) %>

    <main class="dashboard-shell">

        <header class="dashboard-page-heading">

            <div>

                <span class="dashboard-eyebrow">
                    ACCESS CONTROL
                </span>

                <h1>
                    User Management.
                </h1>

                <p>
                    Create and manage reporter
                    and editor accounts.
                </p>

            </div>

        </header>

        <section class="management-panel">

            <header class="management-panel-heading">

                <div>

                    <span class="dashboard-eyebrow">
                        NEW ACCOUNT
                    </span>

                    <h2>
                        Create User
                    </h2>

                </div>

            </header>

            <form
                id="create-user-form"
                class="create-user-grid"
            >

                <label class="dashboard-control">

                    <span>
                        Username
                    </span>

                    <input
                        id="new-username"
                        required
                    >

                </label>

                <label class="dashboard-control">

                    <span>
                        Display Name
                    </span>

                    <input
                        id="new-display-name"
                        required
                    >

                </label>

                <label class="dashboard-control">

                    <span>
                        Password
                    </span>

                    <input
                        id="new-password"
                        type="password"
                        minlength="8"
                        required
                    >

                </label>

                <label class="dashboard-control">

                    <span>
                        Role
                    </span>

                    <select id="new-role">

                        <option value="reporter">
                            Reporter
                        </option>

                        <option value="editor">
                            Editor
                        </option>

                    </select>

                </label>

                <button
                    class="primary-action create-user-button"
                    type="submit"
                >
                    Create User
                </button>

            </form>

            <p
                id="create-user-message"
                class="management-message"
                aria-live="polite"
            ></p>

        </section>

        <section class="dashboard-controls-panel management-filter-panel">

            <form
                class="dashboard-controls user-filter-controls"
                method="GET"
                action="/editor/users"
            >

                <label class="dashboard-control dashboard-search-control">

                    <span>
                        Search
                    </span>

                    <input
                        type="search"
                        name="search"
                        value="<%= search %>"
                        placeholder="Name or username"
                    >

                </label>

                <label class="dashboard-control">

                    <span>
                        Role
                    </span>

                    <select name="role">

                        <option
                            value=""
                            <%= !selectedRole ? "selected" : "" %>
                        >
                            All Roles
                        </option>

                        <option
                            value="reporter"
                            <%= selectedRole === "reporter" ? "selected" : "" %>
                        >
                            Reporter
                        </option>

                        <option
                            value="editor"
                            <%= selectedRole === "editor" ? "selected" : "" %>
                        >
                            Editor
                        </option>

                    </select>

                </label>

                <div class="dashboard-filter-actions">

                    <button
                        class="secondary-action"
                        type="submit"
                    >
                        Apply
                    </button>

                    <a
                        class="text-action"
                        href="/editor/users"
                    >
                        Clear
                    </a>

                </div>

            </form>

        </section>

        <div class="dashboard-result-heading">

            <p class="dashboard-summary">

                <strong>
                    <%= totalUsers %>
                </strong>

                user<%= totalUsers === 1 ? "" : "s" %>

            </p>

        </div>

        <section
            id="user-list"
            class="management-list"
        >

            <% users.forEach(user => { %>

                <article
                    class="management-card user-card"
                    data-user-id="<%= user._id %>"
                >

                    <div class="management-card-heading">

                        <div class="user-identity">

                            <span class="user-avatar">
                                <%= user.displayName
                                    ? user.displayName.charAt(0).toUpperCase()
                                    : "U" %>
                            </span>

                            <div>

                                <h2>
                                    <%= user.displayName %>
                                </h2>

                                <p>
                                    @<%= user.username %>
                                </p>

                            </div>

                        </div>

                        <span
                            class="role-pill role-<%= user.role %>"
                        >
                            <%= user.role %>
                        </span>

                    </div>

                    <div class="management-form-grid">

                        <label class="dashboard-control">

                            <span>
                                Username
                            </span>

                            <input
                                class="user-username"
                                value="<%= user.username %>"
                            >

                        </label>

                        <label class="dashboard-control">

                            <span>
                                Display Name
                            </span>

                            <input
                                class="user-display-name"
                                value="<%= user.displayName %>"
                            >

                        </label>

                        <label class="dashboard-control">

                            <span>
                                Role
                            </span>

                            <select class="user-role">

                                <option
                                    value="reporter"
                                    <%= user.role === "reporter" ? "selected" : "" %>
                                >
                                    Reporter
                                </option>

                                <option
                                    value="editor"
                                    <%= user.role === "editor" ? "selected" : "" %>
                                >
                                    Editor
                                </option>

                            </select>

                        </label>

                        <label class="dashboard-control">

                            <span>
                                New Password
                            </span>

                            <input
                                class="user-password"
                                type="password"
                                minlength="8"
                                placeholder="Leave blank to keep current"
                            >

                        </label>

                    </div>

                    <div class="management-card-footer">

                        <p
                            class="user-message management-message"
                            aria-live="polite"
                        ></p>

                        <div class="management-actions">

                            <button
                                type="button"
                                class="save-user secondary-action"
                            >
                                Save Changes
                            </button>

                            <button
                                type="button"
                                class="delete-user danger-action"
                            >
                                Delete
                            </button>

                        </div>

                    </div>

                </article>

            <% }) %>

        </section>

        <% if (totalPages > 1) { %>

            <nav
                class="dashboard-pagination"
                aria-label="User pages"
            >

                <% if (page > 1) { %>

                    <a
                        href="/editor/users?<%= paginationQuery ? paginationQuery + '&' : '' %>page=<%= page - 1 %>"
                    >
                        Previous
                    </a>

                <% } %>

                <span class="pagination-summary">
                    Page
                    <%= page %>
                    of
                    <%= totalPages %>
                </span>

                <% if (page < totalPages) { %>

                    <a
                        href="/editor/users?<%= paginationQuery ? paginationQuery + '&' : '' %>page=<%= page + 1 %>"
                    >
                        Next
                    </a>

                <% } %>

            </nav>

        <% } %>

    </main>

</body>

</html>