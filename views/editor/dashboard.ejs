<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= pageTitle %></title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="stylesheet"
        href="/css/dashboard.css"
    >
</head>

<body>

    <header class="dashboard-header">

        <h1>
            The Web Daily
        </h1>

        <div class="dashboard-header-actions">

            <nav>
                <a href="/">
                    Public Site
                </a>

                <a href="/editor/analytics">
                    Analytics Impact
                </a>
            </nav>

            <form
                method="POST"
                action="/logout"
            >
                <button type="submit">
                    Logout
                </button>
            </form>

        </div>

    </header>

    <main>

        <h2>
            Editor Dashboard
        </h2>

        <p>
            Welcome,
            <strong>
                <%= currentUser.displayName %>
            </strong>
        </p>

        <form
            class="dashboard-controls"
            method="GET"
            action="/editor"
        >

            <label>
                Search title

                <input
                    type="search"
                    name="search"
                    value="<%= search %>"
                    placeholder="Article title"
                >
            </label>

            <label>
                Status

                <select name="status">

                    <option
                        value=""
                        <%= !selectedStatus ? "selected" : "" %>
                    >
                        All
                    </option>

                    <option
                        value="draft"
                        <%= selectedStatus === "draft" ? "selected" : "" %>
                    >
                        Draft
                    </option>

                    <option
                        value="pending"
                        <%= selectedStatus === "pending" ? "selected" : "" %>
                    >
                        Pending
                    </option>

                    <option
                        value="published"
                        <%= selectedStatus === "published" ? "selected" : "" %>
                    >
                        Published
                    </option>

                    <option
                        value="returned"
                        <%= selectedStatus === "returned" ? "selected" : "" %>
                    >
                        Returned
                    </option>

                </select>
            </label>

            <label>
                Reporter

                <select name="reporter">

                    <option
                        value=""
                        <%= !selectedReporter ? "selected" : "" %>
                    >
                        All Reporters
                    </option>

                    <% reporters.forEach(reporter => { %>

                        <option
                            value="<%= reporter._id %>"
                            <%= selectedReporter === String(reporter._id) ? "selected" : "" %>
                        >
                            <%= reporter.displayName %>
                        </option>

                    <% }) %>

                </select>
            </label>

            <label>
                Sort

                <select name="sort">

                    <option
                        value="updated_desc"
                        <%= selectedSort === "updated_desc" ? "selected" : "" %>
                    >
                        Recently Updated
                    </option>

                    <option
                        value="published_desc"
                        <%= selectedSort === "published_desc" ? "selected" : "" %>
                    >
                        Latest Published
                    </option>

                    <option
                        value="popular"
                        <%= selectedSort === "popular" ? "selected" : "" %>
                    >
                        Most Popular
                    </option>

                    <option
                        value="title_asc"
                        <%= selectedSort === "title_asc" ? "selected" : "" %>
                    >
                        Title A-Z
                    </option>

                </select>
            </label>

            <button type="submit">
                Apply
            </button>

            <a href="/editor">
                Clear
            </a>

        </form>

        <p class="dashboard-summary">
            <strong>
                <%= totalArticles %>
            </strong>
            article<%= totalArticles === 1 ? "" : "s" %>
            found
        </p>

        <% if (articles.length === 0) { %>

            <p>
                No articles found.
            </p>

        <% } %>

        <% articles.forEach(article => { %>

            <article class="dashboard-article">

                <h3>
                    <%= article.workingVersion.title || "Untitled Article" %>
                </h3>

                <p>
                    Reporter:
                    <%= article.author.displayName %>
                </p>

                <p>
                    Status:
                    <strong>
                        <%= article.status %>
                    </strong>
                </p>

                <p>
                    Views:
                    <%= article.totalViews %>
                </p>

                <p>
                    Last updated:
                    <%= new Date(article.updatedAt).toLocaleString("en-GB") %>
                </p>

                <p>
                    <a
                        href="/editor/articles/<%= article._id %>"
                    >
                        Review Article
                    </a>
                </p>

            </article>

            <hr>

        <% }) %>

        <% if (totalPages > 1) { %>

            <nav
                class="dashboard-pagination"
                aria-label="Editor article pages"
            >

                <% if (page > 1) { %>

                    <a
                        href="/editor?<%= paginationQuery ? paginationQuery + '&' : '' %>page=<%= page - 1 %>"
                    >
                        Previous
                    </a>

                <% } %>

                <%
                    const startPage =
                        Math.max(
                            1,
                            page - 2
                        );

                    const endPage =
                        Math.min(
                            totalPages,
                            page + 2
                        );
                %>

                <% for (
                    let pageNumber = startPage;
                    pageNumber <= endPage;
                    pageNumber += 1
                ) { %>

                    <% if (pageNumber === page) { %>

                        <span class="current-page">
                            <%= pageNumber %>
                        </span>

                    <% } else { %>

                        <a
                            href="/editor?<%= paginationQuery ? paginationQuery + '&' : '' %>page=<%= pageNumber %>"
                        >
                            <%= pageNumber %>
                        </a>

                    <% } %>

                <% } %>

                <% if (page < totalPages) { %>

                    <a
                        href="/editor?<%= paginationQuery ? paginationQuery + '&' : '' %>page=<%= page + 1 %>"
                    >
                        Next
                    </a>

                <% } %>

                <span>
                    Page
                    <%= page %>
                    of
                    <%= totalPages %>
                </span>

            </nav>

        <% } %>

    </main>

</body>

</html>