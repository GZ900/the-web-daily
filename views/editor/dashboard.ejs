<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="color-scheme"
        content="light dark"
    >

    <title><%= pageTitle %></title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="stylesheet"
        href="/css/dashboard.css"
    >
    <link rel="stylesheet" href="/css/site.css">
</head>

<body class="staff-page">

    <%- include("../partials/staffHeader", {
        staffRole: "editor",
        activeSection: "dashboard"
    }) %>

    <main class="dashboard-shell">

        <header class="dashboard-page-heading">

            <div>

                <span class="dashboard-eyebrow">
                    EDITOR WORKSPACE
                </span>

                <h1>
                    Newsroom control.
                </h1>

                <p>
                    Welcome,
                    <strong>
                        <%= currentUser.displayName %>
                    </strong>.
                    Review stories, manage publishing
                    and monitor the newsroom.
                </p>

            </div>

        </header>

        <section
            class="dashboard-controls-panel"
            aria-label="Article filters"
        >

            <form
                class="dashboard-controls editor-dashboard-controls"
                method="GET"
                action="/editor"
            >

                <label class="dashboard-control dashboard-search-control">

                    <span>
                        Search
                    </span>

                    <input
                        type="search"
                        name="search"
                        value="<%= search %>"
                        placeholder="Search article title..."
                    >

                </label>

                <label class="dashboard-control">

                    <span>
                        Status
                    </span>

                    <select name="status">

                        <option
                            value=""
                            <%= !selectedStatus ? "selected" : "" %>
                        >
                            All Statuses
                        </option>

                        <option
                            value="draft"
                            <%= selectedStatus === "draft" ? "selected" : "" %>
                        >
                            Draft
                        </option>

                        <option
                            value="pending"
                            <%= selectedStatus === "pending" ? "selected" : "" %>
                        >
                            Pending
                        </option>

                        <option
                            value="published"
                            <%= selectedStatus === "published" ? "selected" : "" %>
                        >
                            Published
                        </option>

                        <option
                            value="returned"
                            <%= selectedStatus === "returned" ? "selected" : "" %>
                        >
                            Returned
                        </option>

                    </select>

                </label>

                <label class="dashboard-control">

                    <span>
                        Reporter
                    </span>

                    <select name="reporter" data-compact-select>

                        <option
                            value=""
                            <%= !selectedReporter ? "selected" : "" %>
                        >
                            All Reporters
                        </option>

                        <% reporters.forEach(reporter => { %>

                            <option
                                value="<%= reporter._id %>"
                                <%= selectedReporter === String(reporter._id) ? "selected" : "" %>
                            >
                                <%= reporter.displayName %>
                            </option>

                        <% }) %>

                    </select>

                </label>

                <label class="dashboard-control">

                    <span>
                        Sort
                    </span>

                    <select name="sort">

                        <option
                            value="updated_desc"
                            <%= selectedSort === "updated_desc" ? "selected" : "" %>
                        >
                            Recently Updated
                        </option>

                        <option
                            value="published_desc"
                            <%= selectedSort === "published_desc" ? "selected" : "" %>
                        >
                            Latest Published
                        </option>

                        <option
                            value="popular"
                            <%= selectedSort === "popular" ? "selected" : "" %>
                        >
                            Most Popular
                        </option>

                        <option
                            value="title_asc"
                            <%= selectedSort === "title_asc" ? "selected" : "" %>
                        >
                            Title A-Z
                        </option>

                    </select>

                </label>

                <div class="dashboard-filter-actions">

                    <button
                        class="secondary-action"
                        type="submit"
                    >
                        Apply
                    </button>

                    <a
                        class="text-action"
                        href="/editor"
                    >
                        Clear
                    </a>

                </div>

            </form>

        </section>

        <div class="dashboard-result-heading">

            <p class="dashboard-summary">

                <strong>
                    <%= totalArticles %>
                </strong>

                article<%= totalArticles === 1 ? "" : "s" %>

            </p>

        </div>

        <% if (articles.length === 0) { %>

            <section class="dashboard-empty-state">

                <h2>
                    No articles found
                </h2>

                <p>
                    Try changing your filters.
                </p>

            </section>

        <% } %>

        <section class="dashboard-article-list">

            <% articles.forEach(article => { %>

                <article class="dashboard-article-card">

                    <div class="dashboard-card-main">

                        <div class="dashboard-card-topline">

                            <span
                                class="status-pill status-<%= article.status %>"
                            >
                                <%= article.status %>
                            </span>

                            <time
                                datetime="<%= new Date(article.updatedAt).toISOString() %>"
                            >
                                Updated
                                <%= new Date(
                                    article.updatedAt
                                ).toLocaleString(
                                    "en-GB",
                                    {
                                        day: "2-digit",
                                        month: "short",
                                        year: "numeric",
                                        hour: "2-digit",
                                        minute: "2-digit",
                                        hour12: false
                                    }
                                ) %>
                            </time>

                        </div>

                        <h2>
                            <%= article.workingVersion.title || "Untitled Article" %>
                        </h2>

                        <div class="dashboard-card-metadata">

                            <span>
                                Reporter
                                <strong>
                                    <%= article.author
                                        ? article.author.displayName
                                        : "Unknown" %>
                                </strong>
                            </span>

                            <span>
                                Views
                                <strong>
                                    <%= article.totalViews || 0 %>
                                </strong>
                            </span>

                        </div>

                    </div>

                    <div class="dashboard-card-action">

                        <a
                            class="card-action-link"
                            href="/editor/articles/<%= article._id %>"
                        >
                            Review Article
                            <span aria-hidden="true">
                                →
                            </span>
                        </a>

                    </div>

                </article>

            <% }) %>

        </section>

        <% if (totalPages > 1) { %>

            <nav
                class="dashboard-pagination"
                aria-label="Editor article pages"
            >

                <% if (page > 1) { %>

                    <a
                        href="/editor?<%= paginationQuery ? paginationQuery + '&' : '' %>page=<%= page - 1 %>"
                    >
                        Previous
                    </a>

                <% } %>

                <%
                    const startPage =
                        Math.max(
                            1,
                            page - 2
                        );

                    const endPage =
                        Math.min(
                            totalPages,
                            page + 2
                        );
                %>

                <% for (
                    let pageNumber = startPage;
                    pageNumber <= endPage;
                    pageNumber += 1
                ) { %>

                    <% if (pageNumber === page) { %>

                        <span class="current-page">
                            <%= pageNumber %>
                        </span>

                    <% } else { %>

                        <a
                            href="/editor?<%= paginationQuery ? paginationQuery + '&' : '' %>page=<%= pageNumber %>"
                        >
                            <%= pageNumber %>
                        </a>

                    <% } %>

                <% } %>

                <% if (page < totalPages) { %>

                    <a
                        href="/editor?<%= paginationQuery ? paginationQuery + '&' : '' %>page=<%= page + 1 %>"
                    >
                        Next
                    </a>

                <% } %>

                <span class="pagination-summary">
                    Page
                    <%= page %>
                    of
                    <%= totalPages %>
                </span>

            </nav>

        <% } %>

    </main>

</body>

</html>