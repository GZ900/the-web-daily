<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="color-scheme"
        content="light dark"
    >

    <title><%= pageTitle %> | The Web Daily</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="stylesheet"
        href="/css/dashboard.css"
    >

    <script
        src="/js/editorReview.js"
        defer
    ></script>
</head>

<body class="staff-page">

    <%- include("../partials/staffHeader", {
        staffRole: "editor",
        activeSection: "dashboard"
    }) %>

    <main class="dashboard-shell">

        <section
            id="editor-review"
            class="editor-review-shell"
            data-article-id="<%= article._id %>"
            data-status="<%= article.status %>"
        >

            <header class="dashboard-page-heading review-page-heading">

                <div>

                    <span class="dashboard-eyebrow">
                        EDITOR REVIEW
                    </span>

                    <h1>
                        Review Article.
                    </h1>

                    <div class="review-metadata">

                        <span>
                            Reporter

                            <strong>
                                <%= article.author.displayName %>
                            </strong>
                        </span>

                        <span
                            class="status-pill status-<%= article.status %>"
                        >
                            <%= article.status %>
                        </span>

                    </div>

                </div>

            </header>

            <% if (article.publishedVersion) { %>

                <section class="review-version-card published-version-card">

                    <header class="review-section-heading">

                        <div>

                            <span class="management-card-label">
                                LIVE VERSION
                            </span>

                            <h2>
                                Currently Published
                            </h2>

                        </div>

                        <span class="review-live-pill">
                            Public
                        </span>

                    </header>

                    <div class="published-preview">

                        <span class="review-category">
                            <%= article.publishedVersion.category %>
                        </span>

                        <h3>
                            <%= article.publishedVersion.title %>
                        </h3>

                        <p class="review-summary">
                            <%= article.publishedVersion.summary %>
                        </p>

                        <div class="review-content-preview">
                            <%= article.publishedVersion.content %>
                        </div>

                    </div>

                </section>

            <% } %>

            <section class="review-version-card">

                <header class="review-section-heading">

                    <div>

                        <span class="management-card-label">
                            WORKING VERSION
                        </span>

                        <h2>
                            Submitted Content
                        </h2>

                    </div>

                </header>

                <div class="editor-form-grid">

                    <label class="dashboard-control editor-field-wide">

                        <span>
                            Title
                        </span>

                        <input
                            id="editor-title"
                            type="text"
                            value="<%= article.workingVersion.title %>"
                        >

                    </label>

                    <label class="dashboard-control">

                        <span>
                            Category
                        </span>

                        <input
                            id="editor-category"
                            type="text"
                            value="<%= article.workingVersion.category %>"
                        >

                    </label>

                    <label class="dashboard-control">

                        <span>
                            Image URL
                        </span>

                        <input
                            id="editor-image"
                            type="url"
                            value="<%= article.workingVersion.imageUrl %>"
                        >

                    </label>

                    <label class="dashboard-control editor-field-wide">

                        <span>
                            Summary
                        </span>

                        <textarea
                            id="editor-summary"
                            class="editor-summary-field"
                        ><%= article.workingVersion.summary %></textarea>

                    </label>

                    <label class="dashboard-control editor-field-wide">

                        <span>
                            Content
                        </span>

                        <textarea
                            id="editor-content"
                            class="editor-content-field"
                        ><%= article.workingVersion.content %></textarea>

                    </label>

                </div>

            </section>

            <% if (article.status === "pending") { %>

                <section class="review-action-card">

                    <div class="review-main-actions">

                        <button
                            type="button"
                            id="editor-save"
                            class="secondary-action"
                        >
                            Save Changes
                        </button>

                        <button
                            type="button"
                            id="editor-approve"
                            class="approve-action"
                        >
                            Approve & Publish
                        </button>

                    </div>

                    <div class="return-to-reporter">

                        <div>

                            <span class="management-card-label">
                                REQUEST CHANGES
                            </span>

                            <h3>
                                Return to Reporter
                            </h3>

                            <p>
                                Explain what should be
                                changed before the article
                                can be approved.
                            </p>

                        </div>

                        <textarea
                            id="editor-note"
                            placeholder="Explain what needs to be changed..."
                        ></textarea>

                        <button
                            type="button"
                            id="editor-return"
                            class="return-action"
                        >
                            Return for Changes
                        </button>

                    </div>

                </section>

            <% } %>

            <section class="review-danger-zone">

                <div>

                    <h3>
                        Delete Article
                    </h3>

                    <p>
                        Permanently remove this article
                        and its related data.
                    </p>

                </div>

                <button
                    type="button"
                    id="editor-delete"
                    class="danger-action"
                >
                    Delete Article
                </button>

            </section>

            <p
                id="editor-message"
                class="management-message review-message"
                aria-live="polite"
            ></p>

        </section>

    </main>

</body>

</html>