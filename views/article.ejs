<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <title><%= pageTitle %> | The Web Daily</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/site.css">
    <script src="/js/article.js" defer></script>
</head>
<body class="public-article-page">
    <%- include("partials/staffHeader") %>
    <main class="article-shell">
        <a class="back-link" href="/">← All stories</a>
        <article class="article-page" data-article-id="<%= article._id %>">
            <header class="article-heading">
                <span class="section-eyebrow"><%= article.publishedVersion.category %></span>
                <h1><%= article.publishedVersion.title %></h1>
                <p class="article-summary"><%= article.publishedVersion.summary %></p>
                <div class="article-metadata">
                    <span>By <strong><%= article.author.displayName %></strong></span>
                    <time datetime="<%= new Date(article.publishedAt).toISOString() %>"><%= new Date(article.publishedAt).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></time>
                    <span><%= article.totalViews %> views</span>
                </div>
            </header>
            <% if (article.publishedVersion.imageUrl) { %>
                <img class="article-hero" src="<%= article.publishedVersion.imageUrl %>" alt="<%= article.publishedVersion.title %>">
            <% } %>
            <div class="article-content"><p><%= article.publishedVersion.content %></p></div>
        </article>
        <section class="comments-section" aria-labelledby="comments-heading">
            <header class="comments-heading">
                <span class="section-eyebrow">THE CONVERSATION</span>
                <h2 id="comments-heading">Join the discussion.</h2>
                <p>Share your perspective on this story.</p>
            </header>
            <form id="comment-form" class="comment-form-card">
                <label class="site-field" for="comment-name"><span>Name</span>
                    <input type="text" id="comment-name" maxlength="80" autocomplete="name" placeholder="Your name" required>
                </label>
                <label class="site-field" for="comment-text"><span>Comment</span>
                    <textarea id="comment-text" maxlength="2000" rows="4" placeholder="Add to the conversation…" required></textarea>
                </label>
                <div class="comment-form-footer">
                    <span>Keep the conversation thoughtful and respectful.</span>
                    <button class="site-primary" type="submit">Post comment</button>
                </div>
                <p id="comment-message" class="site-message" role="status" aria-live="polite"></p>
            </form>
            <div id="comments-list">
                <% comments.forEach(comment => { %>
                    <article class="comment">
                        <strong><%= comment.name %></strong>
                        <p><%= comment.text %></p>
                        <small><%= new Date(comment.createdAt).toLocaleString() %></small>
                    </article>
                <% }) %>
            </div>
        </section>
    </main>
    <%- include("partials/siteFooter") %>
</body>
</html>
