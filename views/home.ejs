<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <meta name="description" content="The latest stories in technology, business, culture and more from The Web Daily newsroom.">
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/site.css">
    <link rel="stylesheet" href="/css/editorial.css">
    <script src="/js/feed.js" defer></script>
    <script src="/js/editorial.js" defer></script>
</head>
<body class="home-page">
    <a class="editorial-skip" href="#top-stories">Skip to the news</a>
    <%- include("partials/staffHeader", { activeSection: "home" }) %>
    <div class="public-topic-bar">
        <%- include("partials/topicNavigation", { topics, archive: false }) %>
    </div>
    <main class="home-shell editorial-home">
        <div class="edition-utilities">
            <p class="edition-date"><%= new Date().toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jerusalem' }) %></p>
            <%- include("partials/compactWeather", { weather }) %>
        </div>
        <% if (popularArticles.length) { %>
            <section class="most-read" aria-labelledby="most-read-heading" id="most-read">
                <h2 id="most-read-heading">Most<br>Read <span aria-hidden="true">↗</span></h2>
                <ol>
                    <% popularArticles.forEach((article, index) => { %>
                        <li><span class="most-read-rank" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span><a href="/articles/<%= article._id %>"><%= article.publishedVersion.title %></a></li>
                    <% }) %>
                </ol>
            </section>
        <% } %>
        <section class="top-stories" id="top-stories" aria-labelledby="top-stories-heading">
            <header class="editorial-section-heading">
                <h1 id="top-stories-heading" tabindex="-1">Top Stories<span class="editorial-period">.</span></h1>
                <span class="editorial-section-note">The latest from our newsroom</span>
            </header>
            <% if (topStories.length) { %>
                <div class="top-stories-grid">
                    <%- include("partials/editorialStory", { article: topStories[0], variant: 'lead' }) %>
                    <% if (topStories.length > 1) { %>
                        <div class="secondary-stories">
                            <% topStories.slice(1).forEach((article, index) => { %>
                                <%- include("partials/editorialStory", { article, variant: index === 0 ? 'secondary' : 'compact' }) %>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
            <% } else { %><p class="editorial-empty">The newsroom is quiet for now. Check back for new stories.</p><% } %>
        </section>
        <div class="category-sections">
            <% categorySections.forEach((section, index) => {
                const layout = section.category.toLowerCase();
                const stories = section.articles;
                const renderStory = (article, variant) => include("partials/editorialStory", { article, variant });
            %>
                <section class="topic-section topic-<%= layout %>" aria-labelledby="topic-section-<%= index %>">
                    <header class="editorial-section-heading">
                        <h2 id="topic-section-<%= index %>"><a href="/?category=<%= encodeURIComponent(section.category) %>#all-stories" data-feed-category="<%= section.category %>"><%= section.category %></a></h2>
                        <a class="section-view-all" href="/?category=<%= encodeURIComponent(section.category) %>#all-stories" data-feed-category="<%= section.category %>" aria-label="View all <%= section.category %> stories">View all <span aria-hidden="true">→</span></a>
                    </header>
                    <div class="topic-story-grid">
                        <% if (layout === 'technology') { %>
                            <% if (stories[0]) { %><div class="topic-primary"><%- renderStory(stories[0], 'feature') %></div><% } %>
                            <% if (stories[1]) { %><div class="topic-secondary"><%- renderStory(stories[1], 'tile') %></div><% } %>
                            <% if (stories.length > 2) { %><div class="topic-story-stack">
                                <% stories.slice(2).forEach(article => { %><%- renderStory(article, 'compact') %><% }) %>
                            </div><% } %>
                        <% } else if (layout === 'business') { %>
                            <% stories.slice(0, 2).forEach(article => { %><div class="topic-prominent"><%- renderStory(article, 'tile') %></div><% }) %>
                            <% [stories.slice(2, 4), stories.slice(4, 6)].filter(group => group.length).forEach(group => { %>
                                <div class="topic-story-stack"><% group.forEach(article => { %><%- renderStory(article, 'compact') %><% }) %></div>
                            <% }) %>
                        <% } else if (layout === 'world' || layout === 'science') { %>
                            <% if (stories.length) { %><div class="topic-main">
                                <%- renderStory(stories[0], 'feature') %>
                                <% if (stories[1]) { %><%- renderStory(stories[1], 'related') %><% } %>
                            </div><% } %>
                            <% if (stories.length > 2) { %><div class="topic-story-stack">
                                <% stories.slice(2).forEach(article => { %><%- renderStory(article, 'compact') %><% }) %>
                            </div><% } %>
                        <% } else { %>
                            <% stories.forEach((article, storyIndex) => { %>
                                <%- renderStory(article, storyIndex < 2 ? 'tile' : 'compact') %>
                            <% }) %>
                        <% } %>
                    </div>
                </section>
            <% }) %>
        </div>
        <section
            class="feed-column" id="all-stories"
            aria-labelledby="all-stories-heading"
        >

            <header class="editorial-section-heading archive-heading">
                <div><span class="editorial-kicker">KEEP EXPLORING</span><h2 id="all-stories-heading" tabindex="-1">All Stories</h2></div>
                <p id="feed-context">The complete newsroom archive.</p>
            </header>
            <%- include("partials/topicNavigation", { topics, archive: true }) %>
            <section
                class="feed-controls-panel"
                aria-label="News controls"
            >

                <div
                    id="feed-controls"
                    class="feed-controls"
                >

                    <label
                        class="
                            feed-control
                            feed-control-search
                        "
                        for="feed-search"
                    >

                        <span class="feed-control-label">
                            Search
                        </span>

                        <div class="search-field">

                            <svg
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                            >
                                <circle
                                    cx="11"
                                    cy="11"
                                    r="7"
                                ></circle>

                                <path
                                    d="M20 20L16.65 16.65"
                                ></path>
                            </svg>

                            <input
                                type="search"
                                id="feed-search"
                                placeholder="Search stories..."
                                autocomplete="off"
                            >

                        </div>

                    </label>

                    <label
                        class="feed-control feed-category-fallback"
                        for="feed-category"
                    >

                        <span class="feed-control-label">
                            Category
                        </span>

                        <select id="feed-category" data-topic-state>

                            <option value="">
                                All Categories
                            </option>

                            <% categories.forEach(category => { %>

                                <option value="<%= category %>">
                                    <%= category %>
                                </option>

                            <% }) %>

                        </select>

                    </label>

                    <label
                        class="feed-control"
                        for="feed-viewed"
                    >

                        <span class="feed-control-label">
                            History
                        </span>

                        <select id="feed-viewed">

                            <option value="all">
                                All Stories
                            </option>

                            <option value="viewed">
                                Viewed
                            </option>

                            <option value="unviewed">
                                Not Viewed
                            </option>

                        </select>

                    </label>

                    <label
                        class="feed-control"
                        for="feed-sort"
                    >

                        <span class="feed-control-label">
                            Sort
                        </span>

                        <select id="feed-sort">

                            <option value="newest">
                                Newest
                            </option>

                            <option value="popular">
                                Most Popular
                            </option>

                        </select>

                    </label>

                </div>

            </section>

            <p
                id="feed-message"
                class="feed-message"
                aria-live="polite"
            ></p>

            <div
                id="news-feed"
                class="news-feed"
            >

                <% articles.forEach(article => { %>

                    <article
                        class="
                            news-card
                            <%= article.publishedVersion.imageUrl
                                ? ""
                                : "news-card--no-image" %>
                        "
                        data-article-id="<%= article._id %>"
                    >

                        <% if (article.publishedVersion.imageUrl) { %>

                            <a
                                class="news-card-image-link"
                                href="/articles/<%= article._id %>"
                                tabindex="-1"
                                aria-hidden="true"
                            >

                                <img
                                    class="news-card-image"
                                    src="<%= article.publishedVersion.imageUrl %>"
                                    alt="<%= article.publishedVersion.title %>"
                                    loading="lazy"
                                >

                            </a>

                        <% } %>

                        <div class="news-card-content">

                            <div class="news-card-topline">

                                <span class="news-category">
                                    <%= article.publishedVersion.category %>
                                </span>

                                <span class="news-views">
                                    <%= article.totalViews || 0 %>
                                    views
                                </span>

                            </div>

                            <h3 class="news-card-title">

                                <a
                                    href="/articles/<%= article._id %>"
                                >
                                    <%= article.publishedVersion.title %>
                                </a>

                            </h3>

                            <p class="news-card-summary">
                                <%= article.publishedVersion.summary %>
                            </p>

                            <footer class="news-card-footer">

                                <span class="news-author">

                                    By

                                    <strong>
                                        <%= article.author
                                            ? article.author.displayName
                                            : "Unknown" %>
                                    </strong>

                                </span>

                                <time
                                    datetime="<%= new Date(article.publishedAt).toISOString() %>"
                                >
                                    <%= new Date(
                                        article.publishedAt
                                    ).toLocaleString(
                                        "en-GB",
                                        {
                                            day: "2-digit",
                                            month: "short",
                                            year: "numeric",
                                            hour: "2-digit",
                                            minute: "2-digit",
                                            hour12: false
                                        }
                                    ) %>
                                </time>

                            </footer>

                        </div>

                    </article>

                <% }) %>

            </div>

            <div
                id="feed-sentinel"
                class="feed-sentinel"
                aria-hidden="true"
            ></div>

        </section>

    </main>
    <button class="smart-scroll" id="smart-scroll" type="button" aria-label="Back to top" title="Back to top" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6 14 6-6 6 6"></path></svg>
    </button>
    <%- include("partials/siteFooter") %>
</body>
</html>
