<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="color-scheme"
        content="light dark"
    >

    <title><%= pageTitle %></title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="stylesheet"
        href="/css/weather.css"
    >

    <script
        src="/js/feed.js"
        defer
    ></script>
</head>

<body class="home-page">

    <%- include("partials/staffHeader", {
        activeSection: "home"
    }) %>

    <main class="home-shell">

        <header class="feed-heading">

            <span class="section-eyebrow">
                THE WEB DAILY
            </span>

            <h1 id="latest-news-heading">
                News for the
                digital world.
            </h1>

            <p class="feed-introduction">
                The latest stories from our
                newsroom, organised in one
                clean and simple place.
            </p>

        </header>

        <section
            class="weather-widget"
            aria-label="Weather"
        >

            <% if (weather) { %>

                <div class="weather-location-block">

                    <div class="weather-live-row">

                        <span
                            class="weather-status-dot"
                            aria-hidden="true"
                        ></span>

                        <span class="weather-kicker">
                            Live Weather
                        </span>

                    </div>

                    <h2>
                        <%= weather.location %>
                    </h2>

                    <p class="weather-description">
                        <%= weather.description %>
                    </p>

                </div>

                <div class="weather-current">

                    <span class="weather-temperature">
                        <%= Math.round(weather.temperature) %>°
                    </span>

                    <span class="weather-unit">
                        C
                    </span>

                </div>

                <dl class="weather-details">

                    <div>

                        <dt>
                            Feels like
                        </dt>

                        <dd>
                            <%= Math.round(weather.apparentTemperature) %>°
                        </dd>

                    </div>

                    <div>

                        <dt>
                            Humidity
                        </dt>

                        <dd>
                            <%= weather.humidity %>%
                        </dd>

                    </div>

                    <div>

                        <dt>
                            Wind
                        </dt>

                        <dd>
                            <%= Math.round(weather.windSpeed) %>
                            km/h
                        </dd>

                    </div>

                    <div>

                        <dt>
                            Rain
                        </dt>

                        <dd>
                            <%= weather.precipitation %>
                            mm
                        </dd>

                    </div>

                </dl>

                <div class="weather-footer">

                    <% if (weather.stale) { %>

                        <span class="weather-warning">
                            Showing the most recent available data.
                        </span>

                    <% } %>

                    <span class="weather-source">

                        Powered by

                        <a
                            href="https://open-meteo.com/"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            Open-Meteo
                        </a>

                    </span>

                </div>

            <% } else { %>

                <p class="weather-unavailable">
                    Weather information is
                    temporarily unavailable.
                </p>

            <% } %>

        </section>

        <section
            class="feed-column"
            aria-labelledby="latest-news-heading"
        >

            <section
                class="feed-controls-panel"
                aria-label="News controls"
            >

                <div
                    id="feed-controls"
                    class="feed-controls"
                >

                    <label
                        class="
                            feed-control
                            feed-control-search
                        "
                        for="feed-search"
                    >

                        <span class="feed-control-label">
                            Search
                        </span>

                        <div class="search-field">

                            <svg
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                            >
                                <circle
                                    cx="11"
                                    cy="11"
                                    r="7"
                                ></circle>

                                <path
                                    d="M20 20L16.65 16.65"
                                ></path>
                            </svg>

                            <input
                                type="search"
                                id="feed-search"
                                placeholder="Search stories..."
                                autocomplete="off"
                            >

                        </div>

                    </label>

                    <label
                        class="feed-control"
                        for="feed-category"
                    >

                        <span class="feed-control-label">
                            Category
                        </span>

                        <select id="feed-category">

                            <option value="">
                                All Categories
                            </option>

                            <% categories.forEach(category => { %>

                                <option value="<%= category %>">
                                    <%= category %>
                                </option>

                            <% }) %>

                        </select>

                    </label>

                    <label
                        class="feed-control"
                        for="feed-viewed"
                    >

                        <span class="feed-control-label">
                            History
                        </span>

                        <select id="feed-viewed">

                            <option value="all">
                                All Stories
                            </option>

                            <option value="viewed">
                                Viewed
                            </option>

                            <option value="unviewed">
                                Not Viewed
                            </option>

                        </select>

                    </label>

                    <label
                        class="feed-control"
                        for="feed-sort"
                    >

                        <span class="feed-control-label">
                            Sort
                        </span>

                        <select id="feed-sort">

                            <option value="newest">
                                Newest
                            </option>

                            <option value="popular">
                                Most Popular
                            </option>

                        </select>

                    </label>

                </div>

            </section>

            <p
                id="feed-message"
                class="feed-message"
                aria-live="polite"
            ></p>

            <div
                id="news-feed"
                class="news-feed"
            >

                <% articles.forEach(article => { %>

                    <article
                        class="
                            news-card
                            <%= article.publishedVersion.imageUrl
                                ? ""
                                : "news-card--no-image" %>
                        "
                        data-article-id="<%= article._id %>"
                    >

                        <% if (article.publishedVersion.imageUrl) { %>

                            <a
                                class="news-card-image-link"
                                href="/articles/<%= article._id %>"
                                tabindex="-1"
                                aria-hidden="true"
                            >

                                <img
                                    class="news-card-image"
                                    src="<%= article.publishedVersion.imageUrl %>"
                                    alt="<%= article.publishedVersion.title %>"
                                    loading="lazy"
                                >

                            </a>

                        <% } %>

                        <div class="news-card-content">

                            <div class="news-card-topline">

                                <span class="news-category">
                                    <%= article.publishedVersion.category %>
                                </span>

                                <span class="news-views">
                                    <%= article.totalViews || 0 %>
                                    views
                                </span>

                            </div>

                            <h2 class="news-card-title">

                                <a
                                    href="/articles/<%= article._id %>"
                                >
                                    <%= article.publishedVersion.title %>
                                </a>

                            </h2>

                            <p class="news-card-summary">
                                <%= article.publishedVersion.summary %>
                            </p>

                            <footer class="news-card-footer">

                                <span class="news-author">

                                    By

                                    <strong>
                                        <%= article.author
                                            ? article.author.displayName
                                            : "Unknown" %>
                                    </strong>

                                </span>

                                <time
                                    datetime="<%= new Date(article.publishedAt).toISOString() %>"
                                >
                                    <%= new Date(
                                        article.publishedAt
                                    ).toLocaleString(
                                        "en-GB",
                                        {
                                            day: "2-digit",
                                            month: "short",
                                            year: "numeric",
                                            hour: "2-digit",
                                            minute: "2-digit",
                                            hour12: false
                                        }
                                    ) %>
                                </time>

                            </footer>

                        </div>

                    </article>

                <% }) %>

            </div>

            <div
                id="feed-sentinel"
                class="feed-sentinel"
                aria-hidden="true"
            ></div>

        </section>

    </main>

    <footer class="site-footer">

        <div class="site-footer-inner">

            <a
                class="footer-brand"
                href="/"
            >
                The Web Daily
            </a>

            <span>
                © 2026
            </span>

        </div>

    </footer>

</body>

</html>