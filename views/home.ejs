<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= pageTitle %></title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="stylesheet"
        href="/css/weather.css"
    >

    <script
        src="/js/feed.js"
        defer
    ></script>
</head>

<body>

    <header>
        <h1>The Web Daily</h1>

        <nav>
            <a href="/">Home</a>
            <a href="/login">Staff Login</a>
        </nav>
    </header>

    <main class="home-layout">

        <section class="feed-column">

            <h2>Latest News</h2>

            <div id="feed-controls">

                <label>
                    Search

                    <input
                        type="search"
                        id="feed-search"
                        placeholder="Search by title"
                    >
                </label>

                <label>
                    Category

                    <select id="feed-category">

                        <option value="">
                            All Categories
                        </option>

                        <% categories.forEach(category => { %>

                            <option value="<%= category %>">
                                <%= category %>
                            </option>

                        <% }) %>

                    </select>
                </label>

                <label>
                    Viewed

                    <select id="feed-viewed">

                        <option value="all">
                            All
                        </option>

                        <option value="viewed">
                            Viewed
                        </option>

                        <option value="unviewed">
                            Not Viewed
                        </option>

                    </select>
                </label>

                <label>
                    Sort

                    <select id="feed-sort">

                        <option value="newest">
                            Newest
                        </option>

                        <option value="popular">
                            Most Popular
                        </option>

                    </select>
                </label>

            </div>

            <p
                id="feed-message"
                aria-live="polite"
            ></p>

            <div id="news-feed">

                <% articles.forEach(article => { %>

                    <article
                        class="news-card"
                        data-article-id="<%= article._id %>"
                    >

                        <% if (article.publishedVersion.imageUrl) { %>

                            <img
                                src="<%= article.publishedVersion.imageUrl %>"
                                alt="<%= article.publishedVersion.title %>"
                                loading="lazy"
                            >

                        <% } %>

                        <p>
                            <strong>
                                <%= article.publishedVersion.category %>
                            </strong>
                        </p>

                        <h3>
                            <a
                                href="/articles/<%= article._id %>"
                            >
                                <%= article.publishedVersion.title %>
                            </a>
                        </h3>

                        <p>
                            <%= article.publishedVersion.summary %>
                        </p>

                        <p>
                            By
                            <%= article.author.displayName %>
                        </p>

                        <p>
                            <%= new Date(article.publishedAt).toLocaleString() %>
                        </p>

                    </article>

                <% }) %>

            </div>

            <div
                id="feed-sentinel"
                aria-hidden="true"
            ></div>

        </section>

        <aside
            class="weather-sidebar"
            aria-label="Weather"
        >

            <section class="weather-widget">

                <h2>Weather</h2>

                <% if (weather) { %>

                    <p class="weather-location">
                        <strong>
                            <%= weather.location %>
                        </strong>
                    </p>

                    <p class="weather-temperature">
                        <%= Math.round(weather.temperature) %>°C
                    </p>

                    <p class="weather-description">
                        <%= weather.description %>
                    </p>

                    <dl class="weather-details">

                        <div>
                            <dt>Feels like</dt>

                            <dd>
                                <%= Math.round(weather.apparentTemperature) %>°C
                            </dd>
                        </div>

                        <div>
                            <dt>Humidity</dt>

                            <dd>
                                <%= weather.humidity %>%
                            </dd>
                        </div>

                        <div>
                            <dt>Wind</dt>

                            <dd>
                                <%= Math.round(weather.windSpeed) %> km/h
                            </dd>
                        </div>

                        <div>
                            <dt>Precipitation</dt>

                            <dd>
                                <%= weather.precipitation %> mm
                            </dd>
                        </div>

                    </dl>

                    <% if (weather.stale) { %>

                        <p class="weather-warning">
                            Showing the last available weather data.
                        </p>

                    <% } %>

                    <p class="weather-source">
                        Weather data:
                        <a
                            href="https://open-meteo.com/"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            Open-Meteo
                        </a>
                    </p>

                <% } else { %>

                    <p>
                        Weather information is temporarily unavailable.
                    </p>

                <% } %>

            </section>

        </aside>

    </main>

    <footer>
        <p>
            &copy; 2026 The Web Daily
        </p>
    </footer>

</body>

</html>