<dialog class="login-dialog" id="login-dialog" aria-labelledby="login-modal-title" aria-describedby="login-modal-description">
    <button class="icon-button login-close" type="button" aria-label="Close login">×</button>
    <span class="section-eyebrow">YOUR NEWSROOM</span>
    <h2 id="login-modal-title">Welcome back.</h2>
    <p id="login-modal-description">Log in to your Reporter or Editor workspace.</p>
    <form class="login-form" method="POST" action="/login">
        <%- include("loginFields", { fieldPrefix: "modal" }) %>
    </form>
    <a class="login-fallback-link" href="/login">Open the login page</a>
</dialog>
