<label class="site-field" for="<%= fieldPrefix %>-username">
    <span>Username</span>
    <input id="<%= fieldPrefix %>-username" name="username" type="text" autocomplete="username" maxlength="50" required>
</label>
<label class="site-field" for="<%= fieldPrefix %>-password">
    <span>Password</span>
    <input id="<%= fieldPrefix %>-password" name="password" type="password" autocomplete="current-password" maxlength="256" required>
</label>
<button class="site-primary" type="submit">Log in</button>
