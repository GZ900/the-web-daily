<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= pageTitle %> | The Web Daily</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >
</head>

<body>

    <header>
        <h1>The Web Daily</h1>

        <nav>
            <a href="/">Public Site</a>
        </nav>
    </header>

    <main>

        <h2>Reporter Dashboard</h2>

        <p>
            Welcome,
            <strong>
                <%= currentUser.displayName %>
            </strong>
        </p>

        <p>
            Reporter workspace is ready.
        </p>

        <form method="POST" action="/logout">
            <button type="submit">
                Logout
            </button>
        </form>

    </main>

</body>

</html>