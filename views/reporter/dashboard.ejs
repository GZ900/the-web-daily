<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= pageTitle %> | The Web Daily</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >
</head>

<body>

    <header>
        <h1>The Web Daily</h1>

        <nav>
            <a href="/">Public Site</a>
        </nav>
    </header>

    <main>

        <h2>Reporter Dashboard</h2>

        <p>
            Welcome,
            <strong><%= currentUser.displayName %></strong>
        </p>

        <form
            method="POST"
            action="/reporter/articles"
        >
            <button type="submit">
                Create New Article
            </button>
        </form>

        <section>

            <h2>My Articles</h2>

            <% if (articles.length === 0) { %>

                <p>You have no articles yet.</p>

            <% } else { %>

                <% articles.forEach(article => { %>

                    <article class="news-card">

                        <h3>
                            <%= article.workingVersion.title || "Untitled Article" %>
                        </h3>

                        <p>
                            Status:
                            <strong>
                                <%= article.status %>
                            </strong>
                        </p>

                        <% if (article.editorNote) { %>

                            <p>
                                Editor note:
                                <%= article.editorNote %>
                            </p>

                        <% } %>

                        <% if (article.status !== "pending") { %>

                            <a
                                href="/reporter/articles/<%= article._id %>/edit"
                            >
                                Edit Article
                            </a>

                        <% } else { %>

                            <p>
                                Waiting for editor approval
                            </p>

                        <% } %>

                    </article>

                <% }) %>

            <% } %>

        </section>

        <form method="POST" action="/logout">
            <button type="submit">
                Logout
            </button>
        </form>

    </main>

</body>

</html>