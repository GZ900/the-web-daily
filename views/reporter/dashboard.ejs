<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="color-scheme"
        content="light dark"
    >

    <title><%= pageTitle %></title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="stylesheet"
        href="/css/dashboard.css"
    >
    <link rel="stylesheet" href="/css/site.css">
</head>

<body class="staff-page">

    <%- include("../partials/staffHeader", {
        staffRole: "reporter",
        activeSection: "dashboard"
    }) %>

    <main class="dashboard-shell">

        <header class="dashboard-page-heading">

            <div>

                <span class="dashboard-eyebrow">
                    REPORTER WORKSPACE
                </span>

                <h1>
                    Your newsroom.
                </h1>

                <p>
                    Welcome,
                    <strong>
                        <%= currentUser.displayName %>
                    </strong>.
                    Create, manage and submit
                    your stories from one place.
                </p>

            </div>

            <form
                class="dashboard-primary-form"
                method="POST"
                action="/reporter/articles"
            >
                <button
                    class="primary-action"
                    type="submit"
                >
                    <span aria-hidden="true">
                        +
                    </span>

                    New Article
                </button>
            </form>

        </header>

        <section
            class="dashboard-controls-panel"
            aria-label="Article filters"
        >

            <form
                class="dashboard-controls"
                method="GET"
                action="/reporter"
            >

                <label class="dashboard-control dashboard-search-control">

                    <span>
                        Search
                    </span>

                    <input
                        type="search"
                        name="search"
                        value="<%= search %>"
                        placeholder="Search article title..."
                    >

                </label>

                <label class="dashboard-control">

                    <span>
                        Status
                    </span>

                    <select name="status">

                        <option
                            value=""
                            <%= !selectedStatus ? "selected" : "" %>
                        >
                            All Statuses
                        </option>

                        <option
                            value="draft"
                            <%= selectedStatus === "draft" ? "selected" : "" %>
                        >
                            Draft
                        </option>

                        <option
                            value="pending"
                            <%= selectedStatus === "pending" ? "selected" : "" %>
                        >
                            Pending
                        </option>

                        <option
                            value="published"
                            <%= selectedStatus === "published" ? "selected" : "" %>
                        >
                            Published
                        </option>

                        <option
                            value="returned"
                            <%= selectedStatus === "returned" ? "selected" : "" %>
                        >
                            Returned
                        </option>

                    </select>

                </label>

                <label class="dashboard-control">

                    <span>
                        Sort
                    </span>

                    <select name="sort">

                        <option
                            value="updated_desc"
                            <%= selectedSort === "updated_desc" ? "selected" : "" %>
                        >
                            Recently Updated
                        </option>

                        <option
                            value="updated_asc"
                            <%= selectedSort === "updated_asc" ? "selected" : "" %>
                        >
                            Oldest Updated
                        </option>

                        <option
                            value="published_desc"
                            <%= selectedSort === "published_desc" ? "selected" : "" %>
                        >
                            Latest Published
                        </option>

                        <option
                            value="title_asc"
                            <%= selectedSort === "title_asc" ? "selected" : "" %>
                        >
                            Title A-Z
                        </option>

                    </select>

                </label>

                <div class="dashboard-filter-actions">

                    <button
                        class="secondary-action"
                        type="submit"
                    >
                        Apply
                    </button>

                    <a
                        class="text-action"
                        href="/reporter"
                    >
                        Clear
                    </a>

                </div>

            </form>

        </section>

        <div class="dashboard-result-heading">

            <p class="dashboard-summary">

                <strong>
                    <%= totalArticles %>
                </strong>

                article<%= totalArticles === 1 ? "" : "s" %>

            </p>

        </div>

        <% if (articles.length === 0) { %>

            <section class="dashboard-empty-state">

                <h2>
                    No articles found
                </h2>

                <p>
                    Try changing your filters
                    or create a new article.
                </p>

            </section>

        <% } %>

        <section class="dashboard-article-list">

            <% articles.forEach(article => { %>

                <article class="dashboard-article-card">

                    <div class="dashboard-card-main">

                        <div class="dashboard-card-topline">

                            <span
                                class="status-pill status-<%= article.status %>"
                            >
                                <%= article.status %>
                            </span>

                            <time
                                datetime="<%= new Date(article.updatedAt).toISOString() %>"
                            >
                                Updated
                                <%= new Date(
                                    article.updatedAt
                                ).toLocaleString(
                                    "en-GB",
                                    {
                                        day: "2-digit",
                                        month: "short",
                                        year: "numeric",
                                        hour: "2-digit",
                                        minute: "2-digit",
                                        hour12: false
                                    }
                                ) %>
                            </time>

                        </div>

                        <h2>
                            <%= article.workingVersion.title || "Untitled Article" %>
                        </h2>

                        <% if (article.editorNote) { %>

                            <div class="editor-note-card">

                                <strong>
                                    Editor note
                                </strong>

                                <p>
                                    <%= article.editorNote %>
                                </p>

                            </div>

                        <% } %>

                    </div>

                    <div class="dashboard-card-action">

                        <% if (article.status !== "pending") { %>

                            <a
                                class="card-action-link"
                                href="/reporter/articles/<%= article._id %>/edit"
                            >
                                Edit Article
                                <span aria-hidden="true">
                                    →
                                </span>
                            </a>

                        <% } else { %>

                            <span class="waiting-message">
                                Waiting for editor approval
                            </span>

                        <% } %>

                    </div>

                </article>

            <% }) %>

        </section>

        <% if (totalPages > 1) { %>

            <nav
                class="dashboard-pagination"
                aria-label="Reporter article pages"
            >

                <% if (page > 1) { %>

                    <a
                        href="/reporter?<%= paginationQuery ? paginationQuery + '&' : '' %>page=<%= page - 1 %>"
                    >
                        Previous
                    </a>

                <% } %>

                <%
                    const startPage =
                        Math.max(
                            1,
                            page - 2
                        );

                    const endPage =
                        Math.min(
                            totalPages,
                            page + 2
                        );
                %>

                <% for (
                    let pageNumber = startPage;
                    pageNumber <= endPage;
                    pageNumber += 1
                ) { %>

                    <% if (pageNumber === page) { %>

                        <span class="current-page">
                            <%= pageNumber %>
                        </span>

                    <% } else { %>

                        <a
                            href="/reporter?<%= paginationQuery ? paginationQuery + '&' : '' %>page=<%= pageNumber %>"
                        >
                            <%= pageNumber %>
                        </a>

                    <% } %>

                <% } %>

                <% if (page < totalPages) { %>

                    <a
                        href="/reporter?<%= paginationQuery ? paginationQuery + '&' : '' %>page=<%= page + 1 %>"
                    >
                        Next
                    </a>

                <% } %>

                <span class="pagination-summary">
                    Page
                    <%= page %>
                    of
                    <%= totalPages %>
                </span>

            </nav>

        <% } %>

    </main>

</body>

</html>