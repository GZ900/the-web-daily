<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= pageTitle %></title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="stylesheet"
        href="/css/dashboard.css"
    >
</head>

<body>

    <%- include("../partials/staffHeader", {
        staffRole: "reporter"
    }) %>

    <main>

        <h2>
            Reporter Dashboard
        </h2>

        <p>
            Welcome,
            <strong>
                <%= currentUser.displayName %>
            </strong>
        </p>

        <form
            method="POST"
            action="/reporter/articles"
        >
            <button type="submit">
                Create New Article
            </button>
        </form>

        <form
            class="dashboard-controls"
            method="GET"
            action="/reporter"
        >

            <label>
                Search title

                <input
                    type="search"
                    name="search"
                    value="<%= search %>"
                    placeholder="Article title"
                >
            </label>

            <label>
                Status

                <select name="status">

                    <option
                        value=""
                        <%= !selectedStatus ? "selected" : "" %>
                    >
                        All
                    </option>

                    <option
                        value="draft"
                        <%= selectedStatus === "draft" ? "selected" : "" %>
                    >
                        Draft
                    </option>

                    <option
                        value="pending"
                        <%= selectedStatus === "pending" ? "selected" : "" %>
                    >
                        Pending
                    </option>

                    <option
                        value="published"
                        <%= selectedStatus === "published" ? "selected" : "" %>
                    >
                        Published
                    </option>

                    <option
                        value="returned"
                        <%= selectedStatus === "returned" ? "selected" : "" %>
                    >
                        Returned
                    </option>

                </select>
            </label>

            <label>
                Sort

                <select name="sort">

                    <option
                        value="updated_desc"
                        <%= selectedSort === "updated_desc" ? "selected" : "" %>
                    >
                        Recently Updated
                    </option>

                    <option
                        value="updated_asc"
                        <%= selectedSort === "updated_asc" ? "selected" : "" %>
                    >
                        Oldest Updated
                    </option>

                    <option
                        value="published_desc"
                        <%= selectedSort === "published_desc" ? "selected" : "" %>
                    >
                        Latest Published
                    </option>

                    <option
                        value="title_asc"
                        <%= selectedSort === "title_asc" ? "selected" : "" %>
                    >
                        Title A-Z
                    </option>

                </select>
            </label>

            <button type="submit">
                Apply
            </button>

            <a href="/reporter">
                Clear
            </a>

        </form>

        <p class="dashboard-summary">
            <strong>
                <%= totalArticles %>
            </strong>
            article<%= totalArticles === 1 ? "" : "s" %>
            found
        </p>

        <% if (articles.length === 0) { %>

            <p>
                No articles found.
            </p>

        <% } %>

        <% articles.forEach(article => { %>

            <article class="dashboard-article">

                <h3>
                    <%= article.workingVersion.title || "Untitled Article" %>
                </h3>

                <p>
                    Status:
                    <strong>
                        <%= article.status %>
                    </strong>
                </p>

                <p>
                    Last updated:
                    <%= new Date(article.updatedAt).toLocaleString("en-GB") %>
                </p>

                <% if (article.editorNote) { %>

                    <p>
                        Editor note:
                        <%= article.editorNote %>
                    </p>

                <% } %>

                <% if (article.status !== "pending") { %>

                    <a
                        href="/reporter/articles/<%= article._id %>/edit"
                    >
                        Edit
                    </a>

                <% } else { %>

                    <p>
                        Waiting for editor approval.
                    </p>

                <% } %>

            </article>

            <hr>

        <% }) %>

        <% if (totalPages > 1) { %>

            <nav
                class="dashboard-pagination"
                aria-label="Reporter article pages"
            >

                <% if (page > 1) { %>

                    <a
                        href="/reporter?<%= paginationQuery ? paginationQuery + '&' : '' %>page=<%= page - 1 %>"
                    >
                        Previous
                    </a>

                <% } %>

                <%
                    const startPage =
                        Math.max(
                            1,
                            page - 2
                        );

                    const endPage =
                        Math.min(
                            totalPages,
                            page + 2
                        );
                %>

                <% for (
                    let pageNumber = startPage;
                    pageNumber <= endPage;
                    pageNumber += 1
                ) { %>

                    <% if (pageNumber === page) { %>

                        <span class="current-page">
                            <%= pageNumber %>
                        </span>

                    <% } else { %>

                        <a
                            href="/reporter?<%= paginationQuery ? paginationQuery + '&' : '' %>page=<%= pageNumber %>"
                        >
                            <%= pageNumber %>
                        </a>

                    <% } %>

                <% } %>

                <% if (page < totalPages) { %>

                    <a
                        href="/reporter?<%= paginationQuery ? paginationQuery + '&' : '' %>page=<%= page + 1 %>"
                    >
                        Next
                    </a>

                <% } %>

                <span>
                    Page
                    <%= page %>
                    of
                    <%= totalPages %>
                </span>

            </nav>

        <% } %>

    </main>

</body>

</html>